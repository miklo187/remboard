# Copy to keystore.properties (gitignored) and fill in real values.
# Release builds are unsigned if this file is absent -- fine for local
# development, required for a Play Store upload.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/remboard-release.jks \
#     -alias remboard -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/remboard-release.jks
storePassword=CHANGE_ME
keyAlias=remboard
keyPassword=CHANGE_ME
